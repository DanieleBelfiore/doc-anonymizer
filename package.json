{
  "name": "doc-anonymizer",
  "productName": "Doc Anonymizer",
  "version": "1.0.0",
  "description": "Local Document Anonymizer",
  "main": "electron/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:vite && npm run build:electron",
    "test:site": "node --test 'tests/*.test.mjs'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=80 --test-coverage-exclude='tests/**' 'tests/*.test.mjs'",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "dev.danielebelfiore.docanonymizer",
    "productName": "Doc Anonymizer",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist",
      "electron",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}.${ext}",
      "extraResources": [
        {
          "from": "resources/bin",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}.${ext}",
      "extraResources": [
        {
          "from": "resources/bin",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "differentialPackage": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}",
      "extraResources": [
        {
          "from": "resources/bin",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/lib",
          "to": "lib",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  },
  "keywords": [],
  "author": "Daniele Belfiore",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@netlify/blobs": "11.1.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wait-on": "9.5.1"
  }
}
