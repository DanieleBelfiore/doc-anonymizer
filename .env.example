# Netlify env vars of the contact function (netlify/functions/contact.mjs).
# Set them in the Netlify dashboard; never commit real values.
RESEND_API_KEY=
# Where messages arrive.
CONTACT_TO=
# Sender on a domain verified in Resend, e.g. "Doc Anonymizer <noreply-doc-anonymizer@danielebelfiore.dev>".
CONTACT_FROM=
# Optional secret: a request with this value in the x-synthetic-test header mails delivered@resend.dev instead of CONTACT_TO.
SYNTHETIC_TEST_TOKEN=
